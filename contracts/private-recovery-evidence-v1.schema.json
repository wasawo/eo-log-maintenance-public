{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eo-log-maintenance.invalid/contracts/private-recovery-evidence-v1.schema.json",
  "title": "Private lock-record preservation metadata v1",
  "description": "Private preservation metadata only; not an owner proof, disposition record or operation permit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "pc_id",
    "log_type",
    "target_period",
    "observed_at_utc",
    "purpose",
    "raw_lock_filename",
    "raw_lock_size",
    "raw_lock_sha256",
    "may_change_state"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "pc_id": {
      "type": "string",
      "enum": [
        "PC-A",
        "PC-B"
      ]
    },
    "log_type": {
      "type": "string",
      "enum": [
        "BattleLog",
        "ErrorReport"
      ]
    },
    "target_period": {
      "type": "string"
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,11})?Z$",
      "maxLength": 32
    },
    "purpose": {
      "const": "lock_record_preservation"
    },
    "raw_lock_filename": {
      "const": "lock-record.bin"
    },
    "raw_lock_size": {
      "type": "integer",
      "minimum": 1
    },
    "raw_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "may_change_state": {
      "type": "boolean",
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "log_type": {
            "const": "BattleLog"
          }
        }
      },
      "then": {
        "properties": {
          "target_period": {
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "minLength": 7,
            "maxLength": 7
          }
        }
      },
      "else": {
        "properties": {
          "target_period": {
            "pattern": "^[0-9]{4}$",
            "minLength": 4,
            "maxLength": 4
          }
        }
      }
    }
  ]
}
